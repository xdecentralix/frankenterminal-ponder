{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "NIXPACKS"
	},
	"deploy": {
		"startCommand": "PONDER_EXPERIMENTAL_DB=platform node_modules/.bin/ponder start --schema frankenterminal_v2 --port $PORT",
		"restartPolicyType": "ON_FAILURE",
		"restartPolicyMaxRetries": 10
	}
}
