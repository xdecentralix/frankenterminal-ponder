# Select port (default: 3000) and profile 
PORT=42069
ALCHEMY_RPC_KEY=...

# (Optional) Postgres database URL. If not provided, SQLite will be used.
DATABASE_URL=...

# Indexing control
MAX_REQUESTS_PER_SECOND=10
POLLING_INTERVAL_MS=30000
# (Optional) "Indexed block" lines for blocks without events are suppressed; set true to show them.
# LOG_EMPTY_BLOCKS=false
# (Optional) Second Avalanche RPC next to Alchemy. Default: https://api.avax.network/ext/bc/C/rpc
# AVALANCHE_FALLBACK_RPC=...

# Config
ENABLE_TRANSACTION_LOG=false