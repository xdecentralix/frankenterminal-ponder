{
	"name": "@frankencoin/ponder",
	"version": "0.3.6",
	"private": false,
	"license": "MIT",
	"scripts": {
		"dev": "yarn install && ponder dev --disable-ui",
		"dev:ui": "yarn install && ponder dev",
		"start": "ponder start",
		"codegen": "ponder codegen",
		"lint": "eslint .",
		"eslint-config-ponder": "workspace:*",
		"typecheck": "tsc",
		"db:backup": "bash scripts/backup/db-dump.sh",
		"db:restore": "bash scripts/backup/db-restore.sh",
		"infra:up": "docker stack deploy -c stack.testing.yml frankencoin-ponder",
		"infra:down": "docker stack remove frankencoin-ponder",
		"postinstall": "patch-package"
	},
	"dependencies": {
		"@frankencoin/zchf": "^0.3.21",
		"hono": "^4.12.6",
		"ponder": "^0.17.9",
		"viem": "^2.55.11"
	},
	"devDependencies": {
		"@types/node": "^25.4.0",
		"@types/pg": "^8.20.0",
		"eslint": "^9.39.4",
		"patch-package": "^8.0.1",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22"
	}
}
